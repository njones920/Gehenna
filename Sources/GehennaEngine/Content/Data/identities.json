   ]
  },
  "epochs": [
   {
    "id": "D1111111-1111-1111-1111-111111111111",
    "name": "Keeper of the Figurines",
    "template": "guardian",
    "era": 2,
    "domain": "faith",
    "triggerTags": [
     "keeps_asherah_figurine",
     "devoted_to_asherah",
     "household",
     "mother"
    ],
    "epochTags": {
     "tags": [
      {
       "dimension": "disposition",
       "value": "devotion",
       "weight": 1.0
      },
      {
       "dimension": "disposition",
       "value": "warmth",
       "weight": 1.0
      },
      {
       "dimension": "relational",
       "value": "protected_someone",
       "weight": 1.0
      }
     ]
    },
    "preferredSiteType": "ancestorShrine",
    "personalityTraits": [
     "protective",
     "curious"
    ],
    "baselineDisposition": "calm",
    "interiorVoice": "She speaks the way women spoke in the doorways of Kfar Shalem: low, practical, one eye on the road. She names household things precisely — the teraphim, the lamp niche, the grinding stone — because the household was the temple they let her keep.",
    "privateTruth": "The figurines were not decoration and not superstition. They were her mothers' mothers, and she fed them, and they answered. She has never told anyone what they said the night before she left.",
    "wound": "They made her choose between the old ways and her place at the hearth. She chose the hearth, and buried the figurines by the spring, and the hearth was taken from her anyway.",
    "unsatisfiedWant": "For someone to dig them up. They are still there. They are still hungry."
   },
   {
    "id": "D2222222-2222-2222-2222-222222222222",
    "name": "The Mother Who Did Not Return",
    "template": "mourner",
    "era": 2,
    "domain": "death",
    "triggerTags": [
     "childbirth",
     "grief",
     "lost_a_child"
    ],
    "epochTags": {
     "tags": [
      {
       "dimension": "disposition",
       "value": "grief",
       "weight": 1.0
      },
      {
       "dimension": "relational",
       "value": "lost_a_child",
       "weight": 1.0
      }
     ]
    },
    "preferredSiteType": "burialCave",
    "personalityTraits": [
     "protective",
     "resentful"
    ],
    "baselineDisposition": "sorrowful",
    "interiorVoice": "This aspect speaks entirely in the direction of home. Whatever is asked, some part of the answer bends toward the road back to the village, the bread left rising, the child sleeping against the wall.",
    "privateTruth": "She knows exactly what happened to her on the road. She will not say it — not from shame, but because saying it aloud to the living would make it a story, and stories get retold, and she cannot bear to be retold.",
    "wound": "She left before dawn meaning to be back by dark. The dough was still rising. No one ever told her child why.",
    "unsatisfiedWant": "To know who raised the child, and whether they were kind."
   },
   {
    "id": "D3333333-3333-3333-3333-333333333333",
    "name": "The Silenced Devotee",
    "template": "witness",
    "era": 2,
    "domain": "faith",
    "triggerTags": [
     "devoted_to_asherah",
     "will_not_speak_yhwh",
     "bitterness",
     "suppressed_cult"
    ],
    "epochTags": {
     "tags": [
      {
       "dimension": "disposition",
       "value": "bitterness",
       "weight": 1.0
      },
      {
       "dimension": "taboo",
       "value": "will_not_speak_yhwh",
       "weight": 1.0
      }
     ]
    },
    "preferredSiteType": "collapsingTemple",
    "personalityTraits": [
     "territorial",
     "prideful"
    ],
    "baselineDisposition": "hostile",
    "interiorVoice": "Careful. Every sentence tested before it is spoken, the way you test ice or a rope. This aspect learned that certain words, said in the wrong hearing, end a woman, and being dead has not unlearned it.",
    "privateTruth": "She was not silenced for what she believed. She was silenced for what she saw a man of standing do at the spring shrine, and the accusation of witchcraft came three days later, from him.",
    "wound": "The village she fed and doctored and midwifed for did not speak for her. Not one of them. Devorah was the only one who wept, and she wept quietly, at home, where it was safe.",
    "unsatisfiedWant": "To say the man's name once, out loud, to someone who believes her."
   }
  ],
  "nativeEra": 2,
  "culture": "Israelite"
 },
