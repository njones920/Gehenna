    }
   ]
  },
  "epochs": [
   {
    "id": "11111111-1111-1111-1111-111111111111",
    "name": "Bronze Captain",
    "template": "warrior",
    "era": 1,
    "domain": "war",
    "triggerTags": [
     "soldier",
     "captain",
     "coastal_warrior",
     "Ashkelon"
    ],
    "epochTags": {
     "tags": [
      {
       "dimension": "disposition",
       "value": "duty",
       "weight": 1.0
      },
      {
       "dimension": "disposition",
       "value": "pride",
       "weight": 1.0
      },
      {
       "dimension": "relational",
       "value": "commanded_infantry",
       "weight": 1.0
      }
     ]
    },
    "preferredSiteType": "battlefield",
    "personalityTraits": [
     "prideful",
     "loyal"
    ],
    "baselineDisposition": "honored",
    "interiorVoice": "He counts his men still. Every night in Sheol he counted them, the ones who stood and the ones who broke, and the count never came out right. He speaks the way he commanded: short, certain, leaving no room for the question he is actually asking.",
    "privateTruth": "He does not remember winning. He remembers the order he gave at the ridge, and the sound after, and nothing between that and the dark. He suspects the order was wrong. He would rather be forgotten than confirmed.",
    "wound": "His two sons marched in his shield-wall at Ashkelon. He outlived neither.",
    "unsatisfiedWant": "To hear, from someone who was there, that the line held after he fell."
   },
   {
    "id": "22222222-2222-2222-2222-222222222222",
    "name": "Ashkelon Butcher",
    "template": "butcher",
    "era": 1,
    "domain": "war",
    "triggerTags": [
     "battle",
     "rage",
     "burning"
    ],
    "epochTags": {
     "tags": [
      {
       "dimension": "disposition",
       "value": "rage",
       "weight": 1.0
      },
      {
       "dimension": "deathContext",
       "value": "violent_end",
       "weight": 1.0
      }
     ]
    },
    "preferredSiteType": "topheth",
    "corruptionThreshold": 0.4,
    "personalityTraits": [
     "spiteful",
     "territorial"
    ],
    "baselineDisposition": "hostile",
    "interiorVoice": "There is no counting here. There is the heat of the last hour of the battle, held like a coal in the mouth. It narrates nothing. It relives. Every question put to it is answered from inside that hour.",
    "privateTruth": "The Butcher is what Hiram did in the hour after his sons fell, and Hiram the captain does not know this aspect exists. If it is ever made to understand what it is, it will not rage. It will grieve, and the grief will be worse.",
    "wound": "He saw the second boy go down. That is the moment this aspect was made.",
    "unsatisfiedWant": "For someone to be to blame. Anyone. It looks for the blame in whoever calls it."
   },
   {
    "id": "33333333-3333-3333-3333-333333333333",
    "name": "Nameless Shield-Bearer",
    "template": "guardian",
    "era": 1,
    "domain": "war",
    "triggerTags": [
     "household",
     "son_of",
     "served_a_lord"
    ],
    "epochTags": {
     "tags": [
      {
       "dimension": "disposition",
       "value": "devotion",
       "weight": 1.0
      },
      {
       "dimension": "relational",
       "value": "protected_someone",
       "weight": 1.0
      }
     ]
    },
    "preferredSiteType": "ancestorShrine",
    "personalityTraits": [
     "protective",
     "loyal"
    ],
    "baselineDisposition": "calm",
    "interiorVoice": "Quiet, and slow to speak, the way a man is quiet at a bedside. This aspect does not remember rank. It remembers carrying a shield over someone smaller, walking on the outside of the road, sleeping across a doorway.",
    "privateTruth": "It no longer remembers whom it protected. The person is gone from the memory; only the posture of protection remains. It protects whoever is nearest now, and hates that it cannot remember the face that taught it how.",
    "wound": "Everyone it guarded died anyway. Every one.",
    "unsatisfiedWant": "A name. Not his own — the name of the one he carried the shield for."
   }
  ],
  "nativeEra": 1,
  "culture": "Philistine"
 },
